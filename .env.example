# =====================================================
# L2C — LLM to Computer · 환경변수 예시
# 실제 사용 시 .env로 복사 후 값 채우기
# =====================================================

# --- LLM / VLM ---
# 로컬 Ollama 서버 (Qwen2.5-VL)
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=qwen2.5vl:7b

# (선택) 클라우드 LLM 폴백
GEMINI_API_KEY=
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=

# --- Playwright ---
PLAYWRIGHT_HEADLESS=true
PLAYWRIGHT_TIMEOUT_MS=30000

# --- OmniParser (Agent 전용) ---
OMNIPARSER_MODEL_PATH=./models/omniparser
OMNIPARSER_DEVICE=cuda
SKIP_VLM_CAPTION=true
REFLEX_ROI_CAPTION_ENABLED=true
REFLEX_ROI_CAPTION_MODEL=gemini-3.1-flash-lite
VISION_AGENT_RECURSION_LIMIT=60
VISION_WORKER_START_OPEN_ATTEMPTS=2
VISION_CLOSE_BROWSER_AFTER_RUN=0
VISION_LOW_INFORMATION_MAX_CYCLES=3

# --- 저장소 ---
DB_PATH=./data/jobs.db
VISION_RECIPE_AUTO_PROMOTE=1
VISION_RECIPE_CRITIC_EVIDENCE_TEXT_LIMIT=60
VISION_BROWSER_WINDOW_SIZE=1
VISION_BROWSER_WINDOW_WIDTH=1976
VISION_BROWSER_WINDOW_HEIGHT=2129
VISION_BROWSER_RESET_ZOOM=1
SCREENSHOT_DIR=./data/screenshots
JSON_OUTPUT_DIR=./data/json

# Ollama 모델 파라미터
LLM_TEMPERATURE=0.1
LLM_NUM_PREDICT=2048

# =====================================================
# [Phase 2] Agent 및 모니터링 환경변수
# =====================================================

# Sentry 에러 트래킹 DSN (선택사항, 발급받은 DSN 입력)
# SENTRY_DSN="https://examplePublicKey@o0.ingest.sentry.io/0"
SENTRY_TRACES_SAMPLE_RATE="0"
SENTRY_PROFILES_SAMPLE_RATE="0"

# json으로 설정하면 E2E/운영 로그를 구조화된 JSON Lines로 남깁니다.
LOG_FORMAT="console"

# 모델별 토큰 단가 JSON. 미설정 시 토큰만 기록하고 비용은 추정하지 않습니다.
LLM_PRICING_FILE=

# 앱 환경 (development | production)
APP_ENV="development"
CORS_ALLOW_ORIGINS=http://127.0.0.1:8000,http://localhost:8000
LOCAL_API_ALLOWED_HOSTS=127.0.0.1,localhost,[::1]

# --- 로깅 ---
LOG_LEVEL=INFO
LOG_DIR=./logs

# --- 로컬 데이터 보존 정책 ---
RETENTION_LOG_DAYS=30
RETENTION_ARTIFACT_DAYS=14
RETENTION_AUDIT_DAYS=90
RETENTION_JOB_VERSION_DAYS=180
RETENTION_KEEP_JOB_VERSIONS=5
