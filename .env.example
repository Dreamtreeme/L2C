# =====================================================
# L2C — LLM to Computer · 환경변수 예시
# 실제 사용 시 .env로 복사 후 값 채우기
# =====================================================

# --- LLM / VLM ---
# 로컬 Ollama 서버 (Qwen2.5-VL)
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=qwen2.5vl:7b

# (선택) 클라우드 LLM 폴백
GEMINI_API_KEY=
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=

# 복잡한 계획·화면 행동·검토 모델
COMMANDER_MODEL=gemini-3.6-flash
COMMANDER_REQUEST_TIMEOUT_SEC=60
# 비정상적으로 긴 구조화 출력이 다음 단계 입력으로 증폭되지 않게 제한합니다. 0이면 해제합니다.
COMMANDER_MAX_OUTPUT_TOKENS=4096
# 화면 행동은 저장 화면 벤치마크에서 검증한 낮은 사고 수준을 사용합니다.
VISION_WORKER_REASONING_THINKING_LEVEL=low
# 구조화·요약·짧은 분류 모델
VISION_LIGHTWEIGHT_MODEL=gemini-3.5-flash-lite
# 0이면 출력 상한을 해제합니다.
VISION_LIGHTWEIGHT_MAX_OUTPUT_TOKENS=1536
VISION_LIGHTWEIGHT_TIMEOUT_SEC=30
VISION_WORKER_REASONING_TIMEOUT_SEC=60
MODEL_TRANSIENT_RETRIES=1
L2C_RUN_DEADLINE_SEC=900

# --- Playwright ---
PLAYWRIGHT_HEADLESS=true
PLAYWRIGHT_TIMEOUT_MS=30000

# --- OmniParser (Agent 전용) ---
OMNIPARSER_MODEL_PATH=./models/omniparser
OMNIPARSER_DEVICE=cuda
# PaddleOCR는 Torch와 분리한 작업자 환경에서 실행합니다.
PADDLE_OCR_PYTHON=.venv-ocr\Scripts\python.exe
PADDLEOCR_USE_GPU=1
PADDLEOCR_LANG=korean
PADDLEOCR_VERSION=PP-OCRv5
VISION_AGENT_RECURSION_LIMIT=180
VISION_AGENT_RECURSION_LIMIT_INCREMENT=90
VISION_CLOSE_BROWSER_AFTER_RUN=1
VISION_PAGE_READY_TIMEOUT_SEC=15
VISION_LOW_INFORMATION_MAX_CAPTURE_CYCLES=2
VISION_PAGE_CAPTURE_RETRY_SEC=0.4
VISION_PAGE_BLANK_MAX_STDDEV=12
VISION_PAGE_BLANK_MAX_EDGE_MEAN=3
VISION_PAGE_BLANK_MIN_DOMINANT_RATIO=0.97
VISION_STABLE_REQUIRED_FRAMES=2

# --- 저장소 ---
DB_PATH=./data/jobs.db
VISION_RECIPE_AUTO_PROMOTE=1
VISION_RECIPE_CRITIC_EVIDENCE_TEXT_LIMIT=60
VISION_RECIPE_CRITIC_TIMEOUT_SEC=30
VISION_RECIPE_PROMOTION_POLL_SEC=1
VISION_RECIPE_PROMOTION_RETRY_DELAY_SEC=30
VISION_RECIPE_PROMOTION_MAX_ATTEMPTS=3
VISION_BROWSER_WINDOW_SIZE=1
VISION_BROWSER_WINDOW_WIDTH=1976
VISION_BROWSER_WINDOW_HEIGHT=2129
VISION_BROWSER_RESET_ZOOM=1
VISION_BROWSER_PROFILE_DIR=./data/browser_profile
SCREENSHOT_DIR=./data/screenshots
JSON_OUTPUT_DIR=./data/json

# Ollama 모델 파라미터
LLM_TEMPERATURE=0.1

# =====================================================
# [Phase 2] Agent 및 모니터링 환경변수
# =====================================================

# Sentry 에러 트래킹 DSN (선택사항, 발급받은 DSN 입력)
# SENTRY_DSN="https://examplePublicKey@o0.ingest.sentry.io/0"
SENTRY_TRACES_SAMPLE_RATE="0"
SENTRY_PROFILES_SAMPLE_RATE="0"

# json으로 설정하면 E2E/운영 로그를 구조화된 JSON Lines로 남깁니다.
LOG_FORMAT="console"

# LangSmith는 명시적으로 활성화한 환경에서만 trace를 전송합니다.
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=l2c-local
LANGSMITH_HIDE_INPUTS=true
LANGSMITH_HIDE_OUTPUTS=true
L2C_LANGSMITH_E2E_FEEDBACK=1
LANGSMITH_FLUSH_TIMEOUT_SEC=5
L2C_E2E_EXPERIMENT=manual
VISION_RECIPE_VERSION=

# 모델별 토큰 단가 JSON. 미설정 시 토큰만 기록하고 비용은 추정하지 않습니다.
LLM_PRICING_FILE=

# 앱 환경 (development | production)
APP_ENV="development"
CORS_ALLOW_ORIGINS=http://127.0.0.1:8000,http://localhost:8000
LOCAL_API_ALLOWED_HOSTS=127.0.0.1,localhost,[::1]

# --- 로깅 ---
LOG_LEVEL=INFO
LOG_DIR=./logs

# --- 로컬 데이터 보존 정책 ---
RETENTION_LOG_DAYS=30
RETENTION_ARTIFACT_DAYS=90
RETENTION_AUDIT_DAYS=90
RETENTION_JOB_VERSION_DAYS=180
RETENTION_KEEP_JOB_VERSIONS=5
