+from classic.extractor.normalization import normalize_dom_posting
+
+
+class _Engine:
+    def extract_from_text(self, _text):
+        return {
+            "company_name": "LLM 회사",
+            "position": "LLM 정규화 제목",
+            "main_tasks": ["API 개발"],
+            "requirements": ["Python 경험"],
+        }
+
+
+def test_dom_identity_fields_override_llm_normalization():
+    posting = normalize_dom_posting(
+        {
+            "company_name": "DOM 회사",
+            "position": "[제품] DOM 원문 제목",
+            "full_text": "주요업무 API 개발 자격요건 Python 경험",
+            "identity_authoritative": True,
+        },
+        url="https://example.com/positions/dynamic",
+        source_platform="example",
+        engine=_Engine(),
+    )
+
+    assert posting.company_name == "DOM 회사"
+    assert posting.position == "[제품] DOM 원문 제목"
+
+
+def test_llm_identity_fields_remain_default():
+    posting = normalize_dom_posting(
+        {
+            "company_name": "DOM 회사",
+            "position": "DOM 원문 제목",
+            "full_text": "주요업무 API 개발 자격요건 Python 경험",
+        },
+        url="https://example.com/positions/dynamic",
+        source_platform="example",
+        engine=_Engine(),
+    )
+
+    assert posting.company_name == "LLM 회사"
+    assert posting.position == "LLM 정규화 제목"
