{
  "site": "jobkorea",
  "display_name": "잡코리아",
  "base_url": "https://www.jobkorea.co.kr",
  "default_query_target": "job search",
  "page_guidance": {
    "home": {
      "instructions": ["보이는 통합검색 입력창에서 사용자 검색어를 입력하고 검색한다."]
    },
    "search": {
      "url_patterns": ["/Search/"],
      "visible_cues": ["검색결과", "채용정보"],
      "minimum_visible_cues": 2,
      "instructions": ["광고가 아닌 공고 제목과 회사명을 한 묶음으로 보고 미방문 카드 큐를 만든다."]
    },
    "job_detail": {
      "url_patterns": ["/Recruit/GI_Read/"],
      "visible_cues": ["상세요강", "모집요강", "지원자격", "근무조건"],
      "minimum_visible_cues": 2,
      "reveal_controls": [],
      "instructions": ["상세 본문과 별도로 보이는 근무조건 요약 영역을 함께 읽는다.", "본문이 탭이나 펼치기 영역에 가려졌을 때만 해당 컨트롤을 연다."],
      "reading_targets": ["회사명", "직무명", "주요업무", "자격요건", "우대사항", "기술", "경력", "학력", "고용형태", "근무지", "급여", "마감일"],
      "navigation_notes": ["상세 공고가 새 탭에 열릴 수 있으므로 뒤로가기가 화면을 바꾸지 않으면 현재 탭 닫기를 고려한다."]
    }
  },
  "collection_policy": {
    "card_identity": ["job title", "company name"],
    "visit_order": "top_to_bottom_visible_unvisited",
    "required_fields": ["회사명", "직무명", "주요업무", "자격요건", "우대사항", "근무조건", "url"],
    "finish_condition": "Requested trend sample size is reached or no unvisited cards remain."
  },
  "reflex_policy": {
    "safe_actions": ["submit_search", "open_detail_tab", "scroll_down", "go_back"],
    "unsafe_actions": ["choose_job_card_without_title", "click_ad"],
    "reason_after_hit": true
  }
}
