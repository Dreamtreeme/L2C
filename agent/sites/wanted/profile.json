{
  "schema_version": 1,
  "registration_order": 10,
  "slug": "wanted",
  "display_name": "원티드",
  "source_platform": "Wanted",
  "aliases": ["wanted", "원티드"],
  "domains": ["wanted.co.kr", "www.wanted.co.kr"],
  "base_url": "https://www.wanted.co.kr",
  "enabled": true,
  "runner": "vision_react",
  "classic_adapter": "wanted",
  "default_query_target": "position search",
  "navigation_policy": {
    "allow_direct_search_url": false,
    "search_entry": "홈 화면의 보이는 검색 UI를 열고 주소를 직접 조합하지 않는다."
  },
  "persistence_policy": {"require_detail_url_for_job_update": true},
  "page_guidance": {
    "home": {"instructions": ["홈 화면의 보이는 검색 UI를 연다."]},
    "search_overlay": {
      "visible_cues": ["검색어를 입력", "추천 검색어"],
      "minimum_visible_cues": 1,
      "instructions": ["검색 입력창에 사용자 검색어를 입력하고 Enter로 제출한다."]
    },
    "search": {
      "url_patterns": ["/search"],
      "instructions": ["직무명과 회사명이 보이는 미방문 공고만 큐에 넣는다."]
    },
    "job_detail": {
      "url_patterns": ["/wd/\\d+"],
      "visible_cues": ["주요업무", "자격요건", "우대사항", "혜택 및 복지"],
      "minimum_visible_cues": 2,
      "reveal_controls": ["상세 정보 더 보기", "상세정보더보기"],
      "instructions": ["상세 정보 더 보기가 보이면 본문을 펼친 뒤 누적해서 읽는다."],
      "reading_targets": ["회사명", "직무명", "주요업무", "자격요건", "우대사항", "기술", "경력", "고용형태", "근무지", "혜택", "마감일"],
      "navigation_notes": ["공고 처리가 끝나면 검색 결과로 돌아가 다음 큐 항목을 처리한다."]
    }
  },
  "collection_policy": {
    "card_identity": ["job title", "company name"],
    "visit_order": "top_to_bottom_visible_unvisited",
    "required_fields": ["회사명", "직무명", "주요업무", "자격요건", "우대사항", "혜택", "url"],
    "finish_condition": "All planned visible cards have been visited or no new unvisited cards are visible."
  },
  "reflex_policy": {
    "safe_actions": ["open_search", "submit_search", "expand_detail", "scroll_down", "go_back"],
    "unsafe_actions": ["replay_recorded_job_title", "choose_job_card_without_semantic_label", "click_reward_badge", "click_tag_chip"],
    "reason_after_hit": true
  },
  "tools": {
    "allowed_tools": ["open_browser", "click_marker", "type_in_marker", "press_key", "scroll", "go_back", "close_current_tab", "switch_tab", "update_extracted_info", "finish_detail_reading", "set_result_card_queue", "finish_task", "close_browser"],
    "tool_rules": {
      "open_browser": "처음에는 공식 홈 주소만 연다.",
      "click_marker": "보이는 마커만 클릭하고 공고 카드는 직무명을 target_label로 보존한다.",
      "go_back": "상세에서 결과 목록으로 돌아갈 때 사용한다."
    },
    "reflex": {
      "enabled_by_profile": true,
      "safe_replay_actions": ["type_in_marker", "press_key", "scroll", "go_back"],
      "conditional_replay_actions": ["click_marker"],
      "requires_reasoning_after_hit": true
    }
  },
  "guidance": "원티드 채용공고 수집. 원티드 홈의 보이는 검색 UI를 사용한다. 검색 결과는 직무명과 회사명으로 식별하고 보상금, 태그, 배지를 카드로 오인하지 않는다. 검색·상세 펼침·스크롤·뒤로가기는 재생 후보지만 실행마다 달라지는 공고 선택은 현재 화면에서 판단한다."
}
