{
  "site": "rocketpunch",
  "display_name": "로켓펀치",
  "base_url": "https://www.rocketpunch.com",
  "default_query_target": "job search",
  "page_guidance": {
    "home": {
      "instructions": ["채용 검색 화면으로 이동해 사용자 검색어를 입력한다."]
    },
    "search": {
      "instructions": ["회사명과 포지션을 함께 확인해 미방문 채용 항목을 선택한다."]
    },
    "job_detail": {
      "url_patterns": ["/jobs/\\d+"],
      "visible_cues": ["주요업무", "자격요건", "우대사항", "채용 상세"],
      "minimum_visible_cues": 2,
      "reveal_controls": [],
      "instructions": ["전용 페이지와 측면 패널을 모두 상세 화면으로 취급하고 보이는 본문을 누적한다."],
      "reading_targets": ["회사명", "직무명", "주요업무", "자격요건", "우대사항", "기술", "경력", "고용형태", "근무지", "혜택"],
      "navigation_notes": ["같은 목록 URL에서 측면 상세가 바뀔 수 있으므로 현재 선택한 회사명과 직무명을 기준으로 판단한다."]
    }
  },
  "collection_policy": {
    "card_identity": ["job title", "company name"],
    "visit_order": "top_to_bottom_visible_unvisited",
    "required_fields": ["회사명", "직무명", "주요업무", "자격요건", "우대사항", "혜택", "url"],
    "finish_condition": "Requested trend sample size is reached or no unvisited cards remain."
  },
  "reflex_policy": {
    "safe_actions": ["submit_search", "scroll_down", "go_back"],
    "unsafe_actions": ["choose_job_card_without_title", "click_tag_chip"],
    "reason_after_hit": true
  }
}
